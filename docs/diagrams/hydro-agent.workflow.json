    {"id": "action", "lane": "tools", "col": 3, "type": "messagebus", "label": "4. 调一个工具", "sublabel": "A01–A12 中选择一个动作", "tag": "TOOL CALL", "width": 180},
    {"id": "evidence", "lane": "tools", "col": 4, "type": "database", "label": "5. 读取结果", "sublabel": "指标 · Gate · 副作用 · 成本", "tag": "EVIDENCE", "width": 175},

    {"id": "optimizer", "lane": "model", "col": 3, "type": "backend", "label": "模型内优化", "sublabel": "XAJ 率定 / OHN 候选训练", "tag": "INNER LOOP", "width": 185}
