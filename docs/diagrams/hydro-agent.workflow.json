  "nodes": [
    {"id": "task", "lane": "ui", "col": 0, "type": "external", "label": "1. 创建任务", "sublabel": "流域 · 日期 · 模型 · 优化权限", "tag": "CONFIG", "width": 165},
    {"id": "replay", "lane": "ui", "col": 5, "type": "database", "label": "7. 冻结回放", "sublabel": "F：只运行，不再调参", "tag": "A11", "width": 170, "yOffset": -42},
    {"id": "report", "lane": "ui", "col": 5, "type": "frontend", "label": "8. 最终报告", "sublabel": "E：只读评价与交付", "tag": "A12", "width": 170, "yOffset": 50},

    {"id": "decide", "lane": "agent", "col": 2, "type": "backend", "label": "3. 判断下一步", "sublabel": "查询 / 预报 / 优化 / KEEP / BLOCK", "tag": "DECIDE", "width": 180},
    {"id": "followup", "lane": "agent", "col": 4, "type": "security", "label": "6. 继续？", "sublabel": "新证据 · 未解决 · 有预算", "tag": "FOLLOW-UP", "width": 170},
    {"id": "freeze", "lane": "agent", "col": 5, "type": "security", "label": "冻结 / 受阻收尾", "sublabel": "ACCEPT · KEEP · BLOCK", "tag": "TERMINAL", "width": 175},

