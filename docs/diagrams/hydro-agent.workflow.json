{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Hydro-Agent 水文预报方案流程",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-flow",
        "label": "一图看懂",
        "focus": ["task", "check", "forecast", "diagnose", "act", "finish"],
        "note": "沿主线理解 Hydro-Agent：输入任务、检查资料、运行模型、智能诊断、执行动作、冻结回放并评价。"
      }
    ]
  },
  "lanes": [
    {"id": "user", "label": "研究者 / 最终结果"},
    {"id": "agent", "label": "智能体：判断下一步做什么"},
    {"id": "tools", "label": "专业工具：检查、处理、验证"},
    {"id": "model", "label": "水文模型：计算未来流量"}
  ],
  "phases": [
    {"id": "build", "label": "B：方案构建与历史适配", "fromCol": 0, "toCol": 4, "variant": "emphasis"},
    {"id": "replay_eval", "label": "F / E：冻结回放与最终评价", "fromCol": 5, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["task", "check", "forecast", "diagnose", "act", "finish"],
  "nodes": [
    {
      "id": "task",
      "lane": "user",
      "col": 0,
      "type": "external",
      "label": "1. 配置预报任务",
      "sublabel": "一次性选定流域、时间、数据和模型",
      "width": 165
    },
    {
      "id": "check",
      "lane": "tools",
      "col": 1,
      "type": "database",
      "label": "2. 检查资料与方案",
      "sublabel": "A01–A04：缺测、时间、单位、起报条件",
      "width": 175
    },
    {
      "id": "forecast",
      "lane": "model",
      "col": 2,
      "type": "backend",
      "label": "3. 运行水文模型",
      "sublabel": "A05：模型负责真正计算未来流量",
      "tag": "Forecast 算子",
      "width": 175
    },
    {
      "id": "diagnose",
      "lane": "agent",
      "col": 3,
      "type": "backend",
      "label": "4. 智能体判断怎么办",
      "sublabel": "A06：KEEP / 修资料 / 重建状态 / 有限适配",
      "tag": "看证据后选动作",
      "width": 195
    },
    {
      "id": "act",
      "lane": "tools",
      "col": 4,
      "type": "messagebus",
      "label": "5. 执行动作并重新验证",
      "sublabel": "A07–A09：工具执行；需要时才小范围调优",
      "tag": "通过则保留，不通过则撤销 / 受阻",
      "width": 205
    },
    {
      "id": "finish",
      "lane": "user",
      "col": 5,
      "type": "frontend",
      "label": "6. 冻结 → 回放 → 评价 → 报告",
      "sublabel": "A10 冻结；A11 自动起报；A12 只读评价",
      "tag": "输出预测、过程记录和评价结果",
      "width": 210
    }
  ],
  "edges": [
    {"id": "task-check", "from": "task", "to": "check", "label": "开始", "variant": "default"},
    {"id": "check-forecast", "from": "check", "to": "forecast", "label": "资料可用", "variant": "emphasis"},
    {"id": "forecast-diagnose", "from": "forecast", "to": "diagnose", "label": "预测结果", "variant": "emphasis"},
    {"id": "diagnose-act", "from": "diagnose", "to": "act", "label": "选择处理动作", "variant": "emphasis"},
    {"id": "act-finish", "from": "act", "to": "finish", "label": "方案通过验证", "variant": "emphasis"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "智能体到底做什么？",
      "items": [
        "它像调度员：读取证据，然后决定下一步调用哪个专业工具",
        "它不直接计算 NSE/KGE，也不直接生成神经网络权重"
      ]
    },
    {
      "dot": "rose",
      "title": "参数优化在哪里？",
      "items": [
        "参数优化只是第 5 步中的一种可选动作",
        "只有持续模型偏差且其他问题排除后，才调用受约束的 Optimizer + Trainer",
        "正常情况下选择 KEEP / 不干预同样是正确结果"
      ]
    },
    {
      "dot": "violet",
      "title": "三个阶段",
      "items": [
        "B：允许用历史资料构建、诊断并有限适配方案",
        "F：方案冻结后自动连续起报，不看测试真值调参",
        "E：最后才读取测试真值做只读评价与报告"
      ]
    }
  ]
}
