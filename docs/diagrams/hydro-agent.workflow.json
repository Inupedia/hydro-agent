        "id": "happy-path",
        "label": "全路径",
        "focus": [
          "user",
          "materials",
          "delineate",
          "boundary",
          "inputs",
          "plan",
          "task",
          "forecast",
          "optimize",
          "gate",
          "keep",
          "freeze",
          "replay",
          "report",
          "results"
        ],
        "note": "从创建到结果说明的完整路径。"
