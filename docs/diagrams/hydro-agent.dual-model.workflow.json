    { "id": "data-ohn", "from": "data_check", "to": "ohn_exec", "label": "model = OHN", "variant": "default", "role": "branch" },
    { "id": "xaj-diagnose", "from": "xaj_exec", "to": "diagnose", "label": "预测 + 证据", "variant": "emphasis" },
    { "id": "ohn-diagnose", "from": "ohn_exec", "to": "diagnose", "label": "预测 + 证据", "variant": "emphasis" },

    { "id": "diagnose-finalize", "from": "diagnose", "to": "finalize", "label": "KEEP / 修复后验证", "variant": "default", "role": "branch" },
    { "id": "diagnose-xaj-opt", "from": "diagnose", "to": "xaj_opt", "label": "XAJ 且需优化", "variant": "dashed", "role": "branch" },
    { "id": "diagnose-ohn-opt", "from": "diagnose", "to": "ohn_opt", "label": "OHN 且需优化", "variant": "dashed", "role": "branch" },
    { "id": "xaj-opt-finalize", "from": "xaj_opt", "to": "finalize", "label": "候选方案", "variant": "default" },
    { "id": "ohn-opt-finalize", "from": "ohn_opt", "to": "finalize", "label": "候选方案", "variant": "default" },
    { "id": "finalize-report", "from": "finalize", "to": "report", "label": "F/E 回放评价", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "前端只选择目标和模型",
      "items": [
        "用户选择流域、日期、XAJ 或 OpenHydroNet，以及是否允许优化",
        "不让用户逐项点击 forecast / calibrate / adapt"
      ]
    },
    {
      "dot": "violet",
      "title": "两个模型是平行能力",
      "items": [
        "XAJ：forecast + calibrate；OpenHydroNet：forecast + adapt",
        "首期任务内模型固定，失败时不静默切换到另一个模型"
      ]
    },
    {
      "dot": "amber",
      "title": "Agent 的核心价值",
      "items": [
        "Agent 判断是否干预、优先处理什么以及选择哪种冻结策略",
