{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Hydro-Agent 双模型：Codex 式证据反馈 Agent Loop",
    "locale": "zh-CN",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-flow",
        "label": "双模型完整业务流程",
        "focus": ["task", "state", "agent", "router", "common_tools", "xaj_exec", "xaj_opt", "ohn_exec", "ohn_opt", "evidence", "follow_up", "freeze", "report"],
        "note": "用户先固定 XAJ 或 OpenHydroNet。Agent 不按固定流水线运行，而是循环观察 TaskState、选择一个合法动作、读取 Tool Output，再决定下一轮或结束。"
      },
      {
        "id": "agent-loop",
        "label": "外层 Agent Query Loop",
        "focus": ["state", "agent", "router", "common_tools", "evidence", "follow_up"],
        "note": "参考 Codex 的 run_turn/tool-output/follow-up 思想：Tool Output 写回状态后，只要 needs_follow_up=true 且仍有新证据与预算，就回到 Agent 再次决策。"
      },
      {
        "id": "model-branches",
        "label": "双模型平行能力与内层优化",
        "focus": ["router", "xaj_exec", "xaj_opt", "ohn_exec", "ohn_opt", "evidence"],
        "note": "XAJ 和 OpenHydroNet 是平行能力提供者。XAJ 的率定器内部执行有界参数搜索；OHN 的 Optimizer/Trainer 内部执行冻结候选搜索；二者都只是外层 Agent 的 Tool。"
      }
    ],
    "output": "docs/diagrams/hydro-agent.dual-model.workflow.html"
  },
  "lanes": [
    {"id": "ui", "label": "任务配置与交付"},
    {"id": "agent", "label": "Hydro Agent Runtime"},
    {"id": "tools", "label": "共同专业工具 / Action Space"},
    {"id": "xaj", "label": "XAJ 新安江模型"},
    {"id": "ohn", "label": "OpenHydroNet"}
  ],
  "phases": [
    {"id": "intake", "label": "任务配置", "fromCol": 0, "toCol": 0},
    {"id": "build", "label": "B：方案构建与历史适配（bounded adaptive loop）", "fromCol": 1, "toCol": 7, "variant": "emphasis"},
    {"id": "frozen", "label": "F / E：冻结回放与只读评价", "fromCol": 8, "toCol": 9, "variant": "dashed"}
  ],
  "groups": [
    {"id": "outer_loop", "label": "外层 Agent Loop：Observe → Decide → Tool → Evidence → Follow-up", "lane": "agent", "fromCol": 1, "toCol": 7, "variant": "emphasis"},
    {"id": "xaj_branch", "label": "XAJ：forecast + bounded calibration", "lane": "xaj", "fromCol": 4, "toCol": 5, "variant": "emphasis"},
    {"id": "ohn_branch", "label": "OpenHydroNet：forecast + bounded adaptation", "lane": "ohn", "fromCol": 4, "toCol": 5, "variant": "dashed"}
  ],
  "mainPath": ["task", "state", "agent", "router", "common_tools", "evidence", "follow_up", "freeze", "report"],
  "nodes": [
    {"id": "task", "lane": "ui", "col": 0, "type": "external", "label": "创建预报任务", "sublabel": "流域 · 日期 · 指定模型 · 预算 · 优化权限", "tag": "一次性配置", "width": 190},
    {"id": "report", "lane": "ui", "col": 9, "type": "frontend", "label": "冻结回放与最终报告", "sublabel": "F 连续起报 · E 只读评价 · 预测/成本/动作账本", "tag": "A11–A12", "width": 230},

    {"id": "state", "lane": "agent", "col": 1, "type": "database", "label": "读取 TaskState", "sublabel": "当前方案 · Evidence · hypotheses · 已尝试动作 · 预算", "tag": "OBSERVE", "width": 225},
    {"id": "agent", "lane": "agent", "col": 2, "type": "backend", "label": "Agent 选择下一动作", "sublabel": "根据新证据更新假设与实验计划", "tag": "DECIDE", "width": 210},
    {"id": "follow_up", "lane": "agent", "col": 7, "type": "security", "label": "needs_follow_up？", "sublabel": "有新证据 + 未解决 + 预算允许 + 阶段允许", "tag": "VERIFY / STOP", "width": 220},
    {"id": "freeze", "lane": "agent", "col": 8, "type": "security", "label": "冻结方案或受阻收尾", "sublabel": "ACCEPT / KEEP → A10；BLOCK 保存现场", "tag": "TERMINAL", "width": 218},

    {"id": "router", "lane": "tools", "col": 3, "type": "messagebus", "label": "Action Router", "sublabel": "A01–A12 是动作空间；校验阶段、能力、策略和预算", "tag": "Tool Router", "width": 232},
    {"id": "common_tools", "lane": "tools", "col": 4, "type": "database", "label": "共同专业工具", "sublabel": "data/context/repair/state/diagnose/compare/recovery", "tag": "A01–A06 / A08–A09", "width": 230},
    {"id": "evidence", "lane": "tools", "col": 6, "type": "database", "label": "EvidencePacket", "sublabel": "tool result · metrics · gates · hypothesis update clues · cost", "tag": "STATE UPDATE", "width": 230},

    {"id": "xaj_exec", "lane": "xaj", "col": 4, "type": "backend", "label": "XAJ forecast", "sublabel": "运行指定方案并重建合法暖机状态", "tag": "A05", "width": 188},
    {"id": "xaj_opt", "lane": "xaj", "col": 5, "type": "backend", "label": "XAJ calibrate", "sublabel": "一次 Tool Call 内由率定器执行多次函数评价", "tag": "A07 · inner optimizer loop", "width": 220},

    {"id": "ohn_exec", "lane": "ohn", "col": 4, "type": "backend", "label": "OpenHydroNet forecast", "sublabel": "运行数据驱动模型与冻结方案", "tag": "A05", "width": 205},
    {"id": "ohn_opt", "lane": "ohn", "col": 5, "type": "backend", "label": "OpenHydroNet adapt", "sublabel": "一次 Tool Call 内由 Optimizer/Trainer 搜索冻结候选", "tag": "A07 · inner optimizer loop", "width": 232}
  ],
  "edges": [
    {"id": "task-state", "from": "task", "to": "state", "label": "初始化任务", "variant": "default"},
    {"id": "state-agent", "from": "state", "to": "agent", "label": "当前可见证据", "variant": "emphasis"},
    {"id": "agent-router", "from": "agent", "to": "router", "label": "选择一个 next_action", "variant": "emphasis"},

    {"id": "router-common", "from": "router", "to": "common_tools", "label": "检查 / 修复 / 诊断 / 比较 / 恢复", "variant": "default", "role": "branch"},
    {"id": "router-xaj-forecast", "from": "router", "to": "xaj_exec", "label": "model=XAJ · forecast", "variant": "default", "role": "branch"},
    {"id": "router-xaj-opt", "from": "router", "to": "xaj_opt", "label": "model=XAJ · CALIBRATE_*", "variant": "dashed", "role": "branch"},
    {"id": "router-ohn-forecast", "from": "router", "to": "ohn_exec", "label": "model=OHN · forecast", "variant": "default", "role": "branch"},
    {"id": "router-ohn-opt", "from": "router", "to": "ohn_opt", "label": "model=OHN · ADAPT_*", "variant": "dashed", "role": "branch"},

    {"id": "common-evidence", "from": "common_tools", "to": "evidence", "label": "Tool Output", "variant": "default"},
    {"id": "xaj-exec-evidence", "from": "xaj_exec", "to": "evidence", "label": "ForecastResult", "variant": "default"},
    {"id": "xaj-opt-evidence", "from": "xaj_opt", "to": "evidence", "label": "CalibrationRun + evaluation", "variant": "default"},
    {"id": "ohn-exec-evidence", "from": "ohn_exec", "to": "evidence", "label": "ForecastResult", "variant": "default"},
    {"id": "ohn-opt-evidence", "from": "ohn_opt", "to": "evidence", "label": "AdaptationRun + evaluation", "variant": "default"},
    {"id": "evidence-follow", "from": "evidence", "to": "follow_up", "label": "写回 TaskState", "variant": "emphasis"},
    {"id": "follow-agent", "from": "follow_up", "to": "agent", "label": "true：重新观察与决策", "variant": "dashed", "role": "return", "route": "bottom-channel"},
    {"id": "follow-freeze", "from": "follow_up", "to": "freeze", "label": "false：ACCEPT / KEEP / BLOCK", "variant": "emphasis", "role": "branch"},
    {"id": "freeze-report", "from": "freeze", "to": "report", "label": "冻结后进入 F/E", "variant": "security"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "像 Codex 调试代码，而不是一次性调参",
      "items": [
        "Codex 是 tool call → tool output → next sampling；Hydro-Agent 对应 action → EvidencePacket → next Agent decision",
        "一个优化失败不会自动结束：它可以成为新证据，促使 Agent 换策略、回查 forcing，或者判断应该 KEEP"
      ]
    },
    {
      "dot": "violet",
      "title": "双层 Loop 的职责必须分开",
      "items": [
        "外层 Agent：what / when / why / continue-or-stop",
        "XAJ 内层率定器：具体有界参数搜索；OHN 内层 Optimizer/Trainer：具体冻结候选搜索",
        "Agent 不直接输出 XAJ 参数向量、learning rate、epoch 或网络权重"
      ]
    },
    {
      "dot": "amber",
      "title": "防止 Agent 把验证集试穿",
      "items": [
        "开发期外层循环有 max_agent_rounds 与 max_optimization_cycles，模型内还有独立候选/函数评价预算",
        "没有新 Evidence 不得重复同一 hypothesis + action + strategy；F/E 永远禁止参数更新"
      ]
    },
    {
      "dot": "rose",
      "title": "P vs A 因此变得可检验",
      "items": [
        "P：冻结的诊断分支、策略顺序和停止规则，Tool Output 不改变预定实验计划",
        "A：每轮 Tool Output 都可改变 hypothesis 和 next_action，但与 P 共享 Tool、候选空间、数据和总预算"
      ]
    }
  ]
}
