{"schema_version":2,"diagram_type":"workflow","meta":{"title":"Hydro-Agent 双模型：外层 Agent Loop + 内层模型优化","locale":"zh-CN","animation":"trace","visual_preset":"signal-flow","quality_profile":"showcase","views":[{"id":"main-flow","label":"双模型主流程","focus":["task","observe","decide","router","xaj_exec","xaj_opt","ohn_exec","ohn_opt","evidence","followup","freeze","report"],"note":"用户先固定模型。Agent 每轮只选择一个合法动作；XAJ 与 OpenHydroNet 是平行的 Tool 能力，结果统一形成 EvidencePacket，再决定是否进入下一轮。"},{"id":"outer-loop","label":"外层 Agent Loop","focus":["observe","decide","router","evidence","followup"],"note":"EvidencePacket 不是最终报告，而是下一轮决策输入。needs_follow_up=true 时回到 Observe。"},{"id":"model-inner-loop","label":"双模型内层优化","focus":["xaj_exec","xaj_opt","ohn_exec","ohn_opt","evidence"],"note":"XAJ calibrate 和 OHN adapt 都在工具内部执行受约束数值搜索；Agent 只选择已冻结策略，不直接给连续数值。"}],"output":"docs/diagrams/hydro-agent.dual-model.workflow.html"},"lanes":[{"id":"ui","label":"任务配置与交付"},{"id":"agent","label":"Hydro Agent：证据驱动决策"},{"id":"tools","label":"Action Router 与统一证据"},{"id":"xaj","label":"XAJ 新安江模型"},{"id":"ohn","label":"OpenHydroNet"}],"phases":[{"id":"build","label":"B：方案构建与历史适配","fromCol":0,"toCol":4,"variant":"emphasis"},{"id":"frozen","label":"F / E：冻结回放与只读评价","fromCol":5,"toCol":5,"variant":"dashed"}],"groups":[{"id":"outer_loop","label":"外层 Agent evidence-feedback loop","lane":"agent","fromCol":1,"toCol":4,"variant":"emphasis"},{"id":"xaj_group","label":"XAJ：forecast / bounded calibration","lane":"xaj","fromCol":3,"toCol":4,"variant":"emphasis"},{"id":"ohn_group","label":"OHN：forecast / bounded adaptation","lane":"ohn","fromCol":3,"toCol":4,"variant":"dashed"}],"mainPath":["task","observe","decide","router","evidence","followup","freeze","report"],"nodes":[{"id":"task","lane":"ui","col":0,"type":"external","label":"创建预报任务","sublabel":"流域 · 日期 · 固定 XAJ 或 OpenHydroNet · 总预算","tag":"一次性配置","width":210},{"id":"report","lane":"ui","col":5,"type":"frontend","label":"冻结回放与最终报告","sublabel":"F 连续起报 → E 只读评价；输出预测、成本和动作账本","tag":"A11–A12","width":230},{"id":"decide","lane":"agent","col":2,"type":"backend","label":"Agent 选择下一动作","sublabel":"根据当前证据决定查什么、做什么、是否值得优化","tag":"DECIDE","width":220},{"id":"followup","lane":"agent","col":4,"type":"security","label":"needs_follow_up？","sublabel":"有新证据 + 未解决 + 预算允许 + B 阶段允许","tag":"CONTINUE / STOP","width":220},{"id":"freeze","lane":"agent","col":5,"type":"security","label":"冻结 / KEEP / BLOCK","sublabel":"结束 B 阶段；测试期不再根据真值改参数","tag":"TERMINAL","width":210},{"id":"observe","lane":"tools","col":1,"type":"database","label":"汇总 Task Evidence","sublabel":"数据 · 状态 · forcing · 模型表现 · 历史相似过程 · 已尝试动作","tag":"OBSERVE","width":230},{"id":"router","lane":"tools","col":3,"type":"messagebus","label":"Action Router","sublabel":"A01–A12 动作空间；检查阶段、模型能力、策略和剩余预算","tag":"TOOL CALL","width":230},{"id":"evidence","lane":"tools","col":4,"type":"database","label":"统一 EvidencePacket","sublabel":"Tool Output · metrics · gates · side effects · cost","tag":"STATE UPDATE","width":230},{"id":"xaj_exec","lane":"xaj","col":3,"type":"backend","label":"XAJ forecast","sublabel":"运行当前参数方案与合法暖机状态","tag":"A05","width":190,"yOffset":-42},{"id":"xaj_opt","lane":"xaj","col":4,"type":"pipeline","label":"XAJ calibrate","sublabel":"率定器内部执行有界参数搜索与多次函数评价","tag":"A07 · INNER LOOP","width":220,"yOffset":42},{"id":"ohn_exec","lane":"ohn","col":3,"type":"backend","label":"OpenHydroNet forecast","sublabel":"运行当前冻结权重与输入方案","tag":"A05","width":205,"yOffset":-42},{"id":"ohn_opt","lane":"ohn","col":4,"type":"pipeline","label":"OpenHydroNet adapt","sublabel":"Optimizer/Trainer 内部搜索冻结候选并训练允许模块","tag":"A07 · INNER LOOP","width":230,"yOffset":42}],"edges":[{"id":"task-observe","from":"task","to":"observe","label":"初始化任务","variant":"default"},{"id":"observe-decide","from":"observe","to":"decide","label":"当前可见证据","variant":"emphasis"},{"id":"decide-router","from":"decide","to":"router","label":"选择一个 next_action","variant":"emphasis"},{"id":"router-evidence","from":"router","to":"evidence","label":"共同工具 A01–A06 / A08–A09","variant":"default","role":"branch"},{"id":"router-xaj-exec","from":"router","to":"xaj_exec","label":"XAJ · forecast","variant":"default","role":"branch"},{"id":"router-xaj-opt","from":"router","to":"xaj_opt","label":"XAJ · CALIBRATE_*","variant":"dashed","role":"branch"},{"id":"router-ohn-exec","from":"router","to":"ohn_exec","label":"OHN · forecast","variant":"default","role":"branch"},{"id":"router-ohn-opt","from":"router","to":"ohn_opt","label":"OHN · ADAPT_*","variant":"dashed","role":"branch"},{"id":"xaj-exec-evidence","from":"xaj_exec","to":"evidence","label":"ForecastResult","variant":"default"},{"id":"xaj-opt-evidence","from":"xaj_opt","to":"evidence","label":"CalibrationRun + evaluation","variant":"default"},{"id":"ohn-exec-evidence","from":"ohn_exec","to":"evidence","label":"ForecastResult","variant":"default"},{"id":"ohn-opt-evidence","from":"ohn_opt","to":"evidence","label":"AdaptationRun + evaluation","variant":"default"},{"id":"evidence-followup","from":"evidence","to":"followup","label":"写回 TaskState","variant":"emphasis"},{"id":"followup-observe","from":"followup","to":"observe","label":"YES：重新观察与决策","variant":"dashed","role":"return","route":"bottom-channel"},{"id":"followup-freeze","from":"followup","to":"freeze","label":"NO：ACCEPT / KEEP / BLOCK","variant":"emphasis","role":"branch"},{"id":"freeze-report","from":"freeze","to":"report","label":"进入 F / E","variant":"security"}],"cards":[{"dot":"cyan","title":"XAJ 与 OHN 是平行 Tool，不是前后步骤","items":["创建任务时先固定模型；Agent 只在该模型能力范围内选动作","模型失败不会自动切换到另一模型，避免实验边界被悄悄改变"]},{"dot":"violet","title":"外层 Loop 才是智能体价值","items":["Tool Output 会改变下一轮 hypothesis 和 next_action","优化失败可以触发换策略、回查 forcing、重建状态或 KEEP"]},{"dot":"amber","title":"内层 Optimizer 保持确定性边界","items":["XAJ 数值率定器决定具体参数向量；OHN Optimizer/Trainer 决定具体候选数值","Agent 不直接生成参数向量、learning rate、epoch 或网络权重"]},{"dot":"rose","title":"正式测试仍然冻结","items":["所有 adaptive loop 只在 B 阶段使用合法开发/验证资料","F 只执行冻结方案，E 只读评价；测试真值绝不反馈回调参"]}]}