      "title_running_zh": "检查建模资料",
      "title_done_zh": "检查了建模资料",
      "explain_zh": "确认 DEM、站点与日资料是否齐全。",
      "phases": [],
      "handler": null,
      "enabled": true,
      "role": "modeling",
      "display_stage": "data",
      "display_node": "materials",
      "requires": [],
      "produces": ["materials"]
    },
    {
      "id": "M02_DELINEATE",
      "kind": "modeling",
      "label_zh": "提取流域与计算单元",
      "title_running_zh": "提取流域与计算单元",
      "title_done_zh": "提取了流域边界",
      "explain_zh": "由出口与 DEM 提取边界和计算单元。",
      "phases": [],
      "handler": null,
      "enabled": true,
      "role": "modeling",
      "display_stage": "data",
      "display_node": "delineate",
      "requires": ["materials"],
      "produces": ["delineation"]
    },
    {
      "id": "M03_REVIEW_BOUNDARY",
      "kind": "modeling",
      "label_zh": "复核出口与边界",
      "title_running_zh": "复核出口与边界",
      "title_done_zh": "确认了流域边界",
      "explain_zh": "查看地图后确认当前边界，修改上游必须另建版本。",
      "phases": [],
      "handler": null,
      "enabled": true,
      "role": "modeling",
      "display_stage": "data",
      "display_node": "boundary",
      "requires": ["delineation"],
      "produces": ["boundary"]
    },
    {
      "id": "M04_BUILD_INPUTS",
      "kind": "modeling",
      "label_zh": "构建面雨量与模型输入",
      "title_running_zh": "构建面雨量与模型输入",
      "title_done_zh": "构建了模型输入",
      "explain_zh": "按空间权重构建面雨量、参数与时间轴。",
      "phases": [],
      "handler": null,
      "enabled": true,
      "role": "modeling",
      "display_stage": "data",
      "display_node": "inputs",
      "requires": ["boundary"],
      "produces": ["model_inputs"]
    },
    {
      "id": "M05_VALIDATE_PLAN",
      "kind": "modeling",
      "label_zh": "校验完整模型方案",
      "title_running_zh": "校验完整模型方案",
      "title_done_zh": "校验了完整方案",
      "explain_zh": "文件校验通过后固定方案版本。",
      "phases": [],
      "handler": null,
      "enabled": true,
      "role": "modeling",
      "display_stage": "data",
      "display_node": "plan",
      "requires": ["model_inputs"],
      "produces": ["model_plan"]
    },
    {
      "id": "A01_CHECK_DATA",
      "kind": "runtime",
      "label_zh": "资料检查",
      "title_running_zh": "正在检查资料",
      "title_done_zh": "检查了资料",
      "explain_zh": "确认本次计算需要的气象与流量资料是否齐全。",
      "phases": ["B", "F", "E"],
      "handler": "check_data",
      "enabled": true,
      "role": "exploratory",
      "display_stage": "data",
      "display_node": "check_data",
      "requires": ["model_plan"],
      "produces": ["data_check"]
    },
    {
      "id": "A02_REPAIR_DATA",
      "kind": "runtime",
      "label_zh": "资料修复",
      "title_running_zh": "正在修复资料",
      "title_done_zh": "修复了资料",
      "explain_zh": "在资料检查失败后尝试修复；当前版本尚未启用。",
      "phases": ["B"],
      "handler": "repair_data",
      "enabled": false,
      "role": "exploratory",
      "display_stage": "data",
      "display_node": "check_data",
      "requires": ["data_check"],
      "produces": ["data_repair"]
    },
    {
      "id": "A03_VALIDATE_SCHEME",
      "kind": "runtime",
      "label_zh": "方案校验",
      "title_running_zh": "正在校验方案",
      "title_done_zh": "校验了方案",
      "explain_zh": "确认基础计算方案可以投入运行。",
      "phases": ["B", "F"],
      "handler": "validate_scheme",
      "enabled": true,
      "role": "exploratory",
      "display_stage": "data",
      "display_node": "validate_scheme",
      "requires": ["data_check"],
      "produces": ["scheme_ok"]
    },
    {
      "id": "A04_REBUILD_STATE",
      "kind": "runtime",
      "label_zh": "重建状态",
      "title_running_zh": "正在重建状态",
      "title_done_zh": "重建了状态",
      "explain_zh": "在状态假设成立时重建暖机状态；当前版本尚未启用。",
      "phases": ["B"],
      "handler": "rebuild_state",
      "enabled": false,
      "role": "exploratory",
      "display_stage": "forecast",
      "display_node": "forecast",
      "requires": ["scheme_ok"],
      "produces": ["state"]
    },
    {
      "id": "A05_FORECAST",
      "kind": "runtime",
      "label_zh": "基础预报",
      "title_running_zh": "正在计算预测",
      "title_done_zh": "完成了流量预测",
      "explain_zh": "用当前方案计算未来几天的流量。",
      "phases": ["B", "F"],
      "handler": "forecast",
      "enabled": true,
      "role": "exploratory",
      "display_stage": "forecast",
      "display_node": "forecast",
      "requires": ["scheme_ok"],
      "produces": ["forecast"]
    },
    {
      "id": "A06_DIAGNOSE",
      "kind": "runtime",
      "label_zh": "预报诊断",
      "title_running_zh": "正在诊断预报误差",
      "title_done_zh": "诊断了预报误差",
      "explain_zh": "对照观测，判断误差更可能来自哪里，以及是否值得率定。",
      "phases": ["B"],
      "handler": "diagnose",
      "enabled": true,
      "role": "exploratory",
      "display_stage": "gate",
      "display_node": "diagnose",
      "requires": ["forecast"],
      "produces": ["diagnosis"]
    },
    {
      "id": "A07_OPTIMIZE",
      "kind": "runtime",
      "label_zh": "有限调参",
      "title_running_zh": "正在尝试调整参数",
      "title_done_zh": "尝试调整了参数",
      "explain_zh": "在有限范围内尝试更合适的参数，不直接搜索连续向量。",
      "phases": ["B"],
      "handler": "optimize",
      "enabled": true,
      "role": "exploratory",
      "display_stage": "gate",
      "display_node": "optimize",
      "requires": ["diagnosis"],
      "produces": ["candidate"]
    },
    {
      "id": "A08_GATE",
      "kind": "runtime",
      "label_zh": "把关 Gate",
      "title_running_zh": "正在检查是否达到要求",
      "title_done_zh": "检查了是否达到要求",
      "explain_zh": "比较候选方案与原方案，看是否值得更换。",
      "phases": ["B"],
      "handler": "gate",
      "enabled": true,
      "role": "closeout",
      "display_stage": "gate",
      "display_node": "gate",
      "requires": ["candidate"],
      "produces": ["gate"]
    },
    {
      "id": "A09_RESOLVE",
      "kind": "runtime",
      "label_zh": "落实 Gate 结论",
      "title_running_zh": "正在落实检查结论",
      "title_done_zh": "落实了检查结论",
      "explain_zh": "根据检查结果决定采用、保留或回退。",
      "phases": ["B", "F"],
      "handler": "resolve",
      "enabled": true,
      "role": "closeout",
      "display_stage": "gate",
      "display_node": "keep",
      "display_node_by_status": {
        "ACCEPT": "accept",
        "KEEP": "keep",
        "ROLLBACK": "rollback",
        "blocked": "blocked",
        "failed": "blocked"
      },
      "requires": ["gate"],
      "produces": ["resolution"]
    },
    {
      "id": "A10_FREEZE",
      "kind": "runtime",
      "label_zh": "冻结方案",
      "title_running_zh": "正在确定采用方案",
      "title_done_zh": "确定了采用方案",
      "explain_zh": "把当前采用方案锁定，供后续回放与报告使用。",
      "phases": ["B"],
      "handler": "freeze",
      "enabled": true,
      "role": "closeout",
      "display_stage": "report",
      "display_node": "freeze",
      "requires": ["resolution"],
      "produces": ["frozen_scheme"]
    },
    {
      "id": "A11_REPLAY",
      "kind": "runtime",
      "label_zh": "历史回放",
      "title_running_zh": "正在做历史资料回放",
      "title_done_zh": "完成了历史资料回放",
      "explain_zh": "用历史资料把锁定方案再跑一遍，方便对照。",
      "phases": ["F"],
      "handler": "replay",
      "enabled": true,
      "role": "closeout",
      "display_stage": "report",
      "display_node": "replay",
      "requires": ["frozen_scheme"],
      "produces": ["replay"]
    },
    {
      "id": "A12_EVALUATE_REPORT",
      "kind": "runtime",
      "label_zh": "评估报告",
      "title_running_zh": "正在整理结果与报告",
      "title_done_zh": "整理了结果与报告",
      "explain_zh": "汇总指标、说明与可下载产物。",
      "phases": ["E"],
      "handler": "evaluate",
      "enabled": true,
      "role": "closeout",
      "display_stage": "report",
      "display_node": "report",
      "requires": ["replay"],
      "produces": ["report"]
    }
  ],
  "transitions": [
    { "from": "user", "to": "M01_CHECK_MATERIALS", "condition": "new_build", "label_zh": "新建" },
    { "from": "user", "to": "reuse", "condition": "reuse_plan", "label_zh": "复用" },
    { "from": "M01_CHECK_MATERIALS", "to": "M02_DELINEATE", "condition": "materials_ok", "label_zh": "资料齐全" },
    { "from": "M02_DELINEATE", "to": "M03_REVIEW_BOUNDARY", "condition": "delineate_ok", "label_zh": "数值检查通过" },
    { "from": "M03_REVIEW_BOUNDARY", "to": "M04_BUILD_INPUTS", "condition": "boundary_confirmed", "label_zh": "确认当前边界" },
    { "from": "M04_BUILD_INPUTS", "to": "M05_VALIDATE_PLAN", "condition": "inputs_ok", "label_zh": "输入校验通过" },
    { "from": "reuse", "to": "M05_VALIDATE_PLAN", "condition": "reuse_valid", "label_zh": "校验文件版本" },
    { "from": "M05_VALIDATE_PLAN", "to": "task", "condition": "plan_bound", "label_zh": "绑定方案" },
    { "from": "task", "to": "A01_CHECK_DATA", "condition": "always", "label_zh": "方案可用才执行" },
    { "from": "A01_CHECK_DATA", "to": "A03_VALIDATE_SCHEME", "condition": "always" },
    { "from": "A03_VALIDATE_SCHEME", "to": "A05_FORECAST", "condition": "always" },
    { "from": "A05_FORECAST", "to": "A06_DIAGNOSE", "condition": "forecast_done", "label_zh": "对照观测" },
    { "from": "A06_DIAGNOSE", "to": "A07_OPTIMIZE", "condition": "needs_calibration", "label_zh": "技巧不足" },
    { "from": "A06_DIAGNOSE", "to": "A10_FREEZE", "condition": "calibration_good_enough", "label_zh": "已够用" },
    { "from": "A07_OPTIMIZE", "to": "A08_GATE", "condition": "candidate_ready", "label_zh": "提交候选" },
    { "from": "A08_GATE", "to": "A09_RESOLVE", "condition": "always", "label_zh": "落实结论" },
    { "from": "A09_RESOLVE", "to": "A10_FREEZE", "condition": "gate_accept_or_stop", "label_zh": "采用或停止搜索" },
    { "from": "A09_RESOLVE", "to": "A07_OPTIMIZE", "condition": "gate_retry_allowed", "label_zh": "换策略再试" },
    { "from": "A09_RESOLVE", "to": "blocked", "condition": "blocked", "label_zh": "暂停或终止" },
    { "from": "A10_FREEZE", "to": "A11_REPLAY", "condition": "always" },
    { "from": "A11_REPLAY", "to": "A12_EVALUATE_REPORT", "condition": "always" },
    { "from": "A12_EVALUATE_REPORT", "to": "results", "condition": "always", "label_zh": "白话说明" }
  ],
  "conditions": {
