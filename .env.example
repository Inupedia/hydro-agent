HYDRO_LLM_BASE_URL=https://api.siliconflow.cn/v1
HYDRO_LLM_MODEL=zai-org/GLM-5.3
SILICONFLOW_API_KEY=
HYDRO_LLM_TIMEOUT_SECONDS=60
HYDRO_AGENT_ACADEMY=data/academy
HYDRO_MAX_CONCURRENT_RUNS=5
HYDRO_MAX_QUEUED_RUNS=20
# Optional. Local docker-compose rewrites the host proxy so containers can reach SiliconFlow.
# DOCKER_HTTP_PROXY=http://host.docker.internal:7897
# DOCKER_HTTPS_PROXY=http://host.docker.internal:7897
